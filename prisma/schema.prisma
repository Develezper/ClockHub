generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ScheduleStatus {
  ACTIVE
  CANCELLED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
}

model User {
  id               Int         @id @default(autoincrement())
  name             String
  email            String      @unique
  password         String
  role             Role        @default(EMPLOYEE)
  status           UserStatus  @default(ACTIVE)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  schedules        Schedule[]
  createdSchedules Schedule[]  @relation("ScheduleCreator")
  auditLogs        AuditLog[]
}

model Schedule {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  status      ScheduleStatus @default(ACTIVE)
  userId      Int
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([startAt])
}

model AuditLog {
  id        Int         @id @default(autoincrement())
  action    AuditAction
  entity    String
  entityId  String?
  message   String
  meta      Json?
  userId    Int?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
